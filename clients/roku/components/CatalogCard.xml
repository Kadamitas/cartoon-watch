<?xml version="1.0" encoding="utf-8"?>
<component name="CatalogCard" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="showContent" />
    <field id="itemHasFocus" type="boolean" onChange="showFocus" />
    <field id="gridHasFocus" type="boolean" onChange="showFocus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/CatalogCard.brs" />
  <children>
    <Rectangle id="frame" width="344" height="225" color="#253045" />
    <Rectangle translation="[4,4]" width="336" height="217" color="#141D2B" />
    <Poster id="poster" translation="[4,4]" width="336" height="164" loadDisplayMode="scaleToZoom" uri="pkg:/images/card.png" />
    <Label id="title" translation="[12,174]" width="320" height="44" numLines="2" wrap="true" font="font:SmallBoldSystemFont" color="#E6E9EF" />
  </children>
</component>
